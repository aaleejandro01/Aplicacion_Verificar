<Window x:Class="Aplicacion_verificacion.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autenticación del Sistema" 
        Height="420" Width="700"
        WindowStartupLocation="CenterScreen" 
        Background="#F8F9FA" Cursor="">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#333333" Height="40">
            <Image Source="/Images/logo.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="30" Margin="10,0,0,0" Stretch="Uniform"/>
            <TextBlock Text="INICIAR SESIÓN" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Rectangle Grid.Row="1" Fill="#D0D0D0" />

        <Grid Grid.Row="2">

            <Border Background="#EAECEE" 
                    Width="300" Height="310"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    BorderBrush="#D0D0D0" 
                    BorderThickness="1"
                    Margin="30">

                <StackPanel Margin="20">

                    <TextBlock Text="Correo electrónico:" Foreground="Black" Margin="0,0,0,5" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="TxtEmail" Height="28" Padding="5" FontSize="12" Margin="0,0,0,15"/>

                    <TextBlock Text="Contraseña:" Foreground="Black" Margin="0,0,0,5" FontSize="12" FontWeight="Bold"/>
                    <PasswordBox x:Name="TxtPassword" Height="28" Padding="5" FontSize="12" Margin="0,0,0,25"/>

                    <Button x:Name="BtnLogin" 
                            Content="ENTRAR" 
                            Width="180" Height="45" 
                            FontSize="16" FontWeight="Bold" 
                            Background="#2C3E50" Foreground="White" 
                            Cursor="Hand" Click="BtnLogin_Click"/>

                    <TextBlock x:Name="TxtEstado" 
                               Foreground="Gray" Margin="0,20,0,0" 
                               FontSize="14" TextWrapping="Wrap" 
                               HorizontalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
